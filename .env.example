PENSION_DATA_ROOT=./data/raw/연금
PARSED_DATA_ROOT=./data/parsed
INDEX_DATA_ROOT=./data/indexes

GENERATOR_BACKEND=fake
APP_ENV=development
HCX_API_KEY=
HCX_MODEL=
HCX_BASE_URL=
HCX_TIMEOUT_SECONDS=30
HCX_MAX_RETRIES=2
HCX_MIN_INTERVAL_SECONDS=2

# Optional NCP-1 integrations. Disabled by default; secrets stay in .env only.
NCP_OBJECT_STORAGE_ENABLED=false
NCP_OBJECT_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_OBJECT_BUCKET=

# JSONL is intended for Cloud Log Analytics Custom Log collection. Leaving the
# path empty disables it. Raw user questions remain opt-in for privacy.
PENSION_TRACE_PATH=
PENSION_TRACE_INCLUDE_QUESTION=false
PENSION_AGENT_VERSION=
