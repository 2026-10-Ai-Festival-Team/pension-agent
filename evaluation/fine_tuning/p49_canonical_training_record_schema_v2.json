{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P49 Canonical Generator Training Record v2",
  "description": "Provider-neutral generator record with an explicit answer-policy outcome. It is not a CLOVA Studio upload payload.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "question",
    "selected_requirements",
    "direct_evidence",
    "cited_chunk_ids",
    "outcome",
    "evidence_status",
    "missing_conditions",
    "unsupported_requirements",
    "completion",
    "quality"
  ],
  "properties": {
    "schema_version": {"const": "p49.training_record.v2"},
    "record_type": {"const": "training_example"},
    "question": {"type": "string", "minLength": 1},
    "selected_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "direct_evidence": {"type": "array", "minItems": 1},
    "cited_chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "outcome": {"enum": ["supported_answer", "clarification_required", "bounded_answer"]},
    "evidence_status": {"enum": ["full", "partial", "none"]},
    "missing_conditions": {"type": "array", "items": {"type": "string"}},
    "unsupported_requirements": {"type": "array", "items": {"type": "string"}},
    "completion": {"type": "string", "pattern": "^\\[답변\\][\\s\\S]*\\[근거\\][\\s\\S]*\\[유의사항\\][\\s\\S]*$"},
    "quality": {"type": "object"}
  },
  "additionalProperties": true
}
